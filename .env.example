# CS2 Open World Environment Variables
# Copy to .env and fill in values

# PostgreSQL
OW_PG_ADMIN_PASSWORD=replace-with-strong-password
OW_PG_MIGRATOR_PASSWORD=replace-with-strong-password
OW_PG_APP_PASSWORD=replace-with-strong-password
OW_PG_CONNINFO=host=127.0.0.1 port=5432 dbname=openworld user=ow_app password=replace-with-strong-password sslmode=prefer connect_timeout=3

# Redis (only for experimental fallback builds)
OW_REDIS_PASSWORD=replace-with-strong-password
OW_REDIS_USERNAME=default

# Config path override
OW_CONFIG_PATH=addons/cs2-openworld/configs/openworld.ini

