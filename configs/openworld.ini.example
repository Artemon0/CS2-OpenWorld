# CS2 Open World Configuration
# Copy to addons/cs2-openworld/configs/openworld.ini

[core]
server_id = server-01
environment = production
enabled = 1

[persistence]
provider = postgresql
connection_env = OW_PG_CONNINFO
connect_timeout = 5

[cache]
provider = memory
shared_provider = none
redis_host = 127.0.0.1
redis_port = 6379
redis_database = 0
redis_username_env = OW_REDIS_USERNAME
redis_password_env = OW_REDIS_PASSWORD
redis_key_prefix = openworld:production:
redis_timeout_ms = 250
redis_max_value_bytes = 4194304
redis_tls = false
warmup_workers = 2
warmup_queue_capacity = 4096

[servers.server-01]
connect = 127.0.0.1:27015
map = de_dust2
max_players = 32
workshop_collection_id = 

[servers.server-02]
connect = 127.0.0.1:27016
map = de_mirage
max_players = 32
workshop_collection_id = 

[zones.downtown]
server_id = server-01
map = de_dust2
min_x = -2048
min_y = -2048
max_x = 0
max_y = 0

[zones.industry]
server_id = server-02
map = de_mirage
min_x = 0
min_y = 0
max_x = 2048
max_y = 2048
